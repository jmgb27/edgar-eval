# ─────────────────────────────────────────────────────────────
# edgar-eval — copy to .env and fill in.
# .env is gitignored. Never commit real keys.
#
# Nothing here is required to run `/search`. Hybrid retrieval,
# reranking and the retrieval half of the benchmark all work with
# this file left exactly as shipped.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
POSTGRES_USER=edgar
POSTGRES_PASSWORD=edgar
POSTGRES_DB=edgar
# 5442, not 5432: colliding with a Postgres the reviewer already runs is a
# bad first impression. Nothing here assumes the default port.
POSTGRES_PORT=5442
# Set by compose for containers; only needed when running scripts on the host.
DATABASE_URL=postgresql://edgar:edgar@localhost:5442/edgar

# ── Embeddings service ──────────────────────────────────────
EMBEDDINGS_PORT=8081
EMBEDDINGS_URL=http://localhost:8081
# Weights are baked into the image at build time. Changing these requires
# `docker compose build embeddings` and a full re-index.
EMBEDDING_MODEL=BAAI/bge-m3
# Measured on this stack (Docker Desktop, 4 vCPU, M1 Max host):
#   bge-reranker-base (278M)   24 pairs -> ~2.2s
# bge-reranker-v2-m3 (568M) is more accurate and roughly 2x slower again.
# Numbers here are measured, not quoted from a model card — see README.
RERANKER_MODEL=BAAI/bge-reranker-base
# Leave blank: the service sizes its thread pool from the container's actual
# CPU allocation. Docker Desktop typically grants far fewer cores than the
# host has (4 of 10 on a stock M1 Max), and oversubscribing them is slower,
# not faster. Raise Docker's CPU allocation before touching this.
EMBED_THREADS=

# ── SEC EDGAR ───────────────────────────────────────────────
# SEC requires a declared User-Agent with a real contact address and
# throttles at 10 req/s. We self-limit to 5. Requests without this are
# blocked — put your own email here.
EDGAR_USER_AGENT=edgar-eval you@example.com
MAX_FILING_BYTES=26214400

# ── Generation model (optional) ─────────────────────────────
# Qwen via Alibaba Cloud Model Studio, OpenAI-compatible mode. Also works
# with OpenRouter (base URL https://openrouter.ai/api/v1, model
# qwen/qwen3.7-plus) or a self-hosted vLLM endpoint.
# Leave QWEN_API_KEY blank to run in extractive mode: /ask returns the
# top-ranked source passage verbatim instead of a synthesised answer.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

# ── Judge model (optional — only for `make eval`) ────────────
# `make eval-retrieval` needs no key at all.
ANTHROPIC_API_KEY=
JUDGE_MODEL=claude-haiku-4-5

# ── Langfuse (optional) ─────────────────────────────────────
# Leave blank to disable tracing — the app runs identically without it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Segments traces in the Langfuse UI: development | staging | production
LANGFUSE_TRACING_ENVIRONMENT=development

# ── Retrieval tuning ────────────────────────────────────────
RETRIEVAL_POOL=40          # per-arm candidates (dense and lexical each)
RETRIEVAL_FUSED=24         # survivors of RRF, fed to the reranker
RETRIEVAL_TOPK=6           # survivors of reranking, fed to the generator
RERANK_MIN_SCORE=0.05
# Give the reranker the same contextual header the embedder saw. An open
# ablation dimension — see docs/measurements.md.
RERANK_WITH_CONTEXT=false
HNSW_EF_SEARCH=100
MAX_RETRIEVAL_ATTEMPTS=2

# ── Bootstrap ───────────────────────────────────────────────
# 1 = seed the ~1,200-chunk AAPL+MSFT demo corpus on first `up`.
SEED_DEMO=1
